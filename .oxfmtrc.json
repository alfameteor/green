{
  "useTabs": true,
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react",
          "react-*",
          "react-dom",
          "react-dom/*"
        ]
      }
    ],
    "groups": [
      "builtin",
      "react",
      "external",
      "internal",
      [
        "parent",
        "sibling",
        "index"
      ],
      "unknown"
    ]
  }
}
