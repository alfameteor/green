{
  "name": "green-api-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:lint": "oxlint src",
    "check:fmt": "oxfmt --check src",
    "format": "oxfmt src",
    "check": "npm run typecheck && npm run check:lint && npm run check:fmt && npm test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "@tanstack/react-query": "^5.104.0",
    "classnames": "^2.5.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.90.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "~5.7.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
